{
  "manifest_version": 3,
  "name": "Weverse 한국어 라이브 번역 오버레이",
  "version": "1.14.0",
  "description": "큐티스트리트 인간 번역기의 공개 실시간·보관 번역을 위버스 생방송과 다시보기 영상 위에 표시합니다.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://weverse.io/*",
    "https://api.cutiestreet.kro.kr/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "한국어 번역 오버레이 켜기/끄기",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "toggle-overlay": {
      "suggested_key": {
        "default": "Alt+Shift+K"
      },
      "description": "한국어 번역 오버레이 켜기/끄기"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://weverse.io/*"
      ],
      "js": [
        "page-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://weverse.io/*"
      ],
      "js": [
        "vendor/convex.js",
        "core.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
